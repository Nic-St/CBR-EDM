{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cbredm",
  "main": "src/index.js",
  // Set this to the day you first deploy, then leave it alone.
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "c_edm_db",
      // Placeholder. Replace with the real ID after running:
      // npx wrangler d1 create c_edm_db
      "database_id": "462efa2b-18f7-4af3-b43c-4f7e8f3651f2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FLYERS",
      // Placeholder. Replace after running: npx wrangler r2 bucket create c-edm-flyers
      "bucket_name": "c-edm-flyers"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      // Replace with the project mailbox once it is verified on Email Routing.
      "destination_address": "cbredmadmin@gmail.com"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_ACCESS_TEAM_DOMAIN",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUDIENCE_TAG",
    // This is Cloudflare's published "always passes" Turnstile test site key,
    // so local dev and preview deploys work out of the box. Replace with the
    // real site key from step 9 before going live.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEyZpRNG0EzCAKcn",
    // Must be the same address as the send_email destination_address above.
    "ADMIN_EMAIL": "cbredmadmin@gmail.com",
    // Any random string. Only used to salt rate-limit hashes; rotating it
    // just resets rate-limit history, it does not need to be memorable.
    "RATE_LIMIT_SALT": "REPLACE_WITH_A_RANDOM_STRING"
  },
  "observability": {
    "enabled": true
  },
  // Exposes env.CF_VERSION_METADATA.id, a per-deployment identifier, so the
  // build comment in the page footer can tell deployed versions apart.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
